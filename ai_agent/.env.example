# ===== Добавить в общий .env.example проекта =====
AI_AGENT_URL=http://ai-agent:8000
AI_AGENT_API_KEY=            # общий секрет бэкенда и агента, заголовок X-Internal-Key

# ---- Схема, на которой идёт демо команды ----
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=https://llm.api.cloud.yandex.net/v1
#   OPENAI_MODEL=gpt://<folder_id>/yandexgpt/latest      # YandexGPT Pro; дешевле — yandexgpt-lite
#   OPENAI_API_KEY=<API-ключ сервисного аккаунта Yandex Cloud, роль ai.languageModels.user>
#   IMAGE_PROVIDER=pollinations                          # картинки бесплатно, без ключа
#
# ---- Запасная схема: всё бесплатно, без ключей ----
# Текст: Pollinations, OpenAI-совместимый API, модель класса GPT (≈1 запрос в 15 с, агент сам ждёт)
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=https://text.pollinations.ai/openai
#   OPENAI_MODEL=openai
#   OPENAI_API_KEY=none
# Альтернатива 1: Groq, бесплатная открытая модель OpenAI gpt-oss-120b (ключ с console.groq.com, без карты;
#   ~1000 запросов в день, 30 в минуту)
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-120b
#   OPENAI_API_KEY=<ключ Groq, gsk_...>
# Альтернатива 2: OpenRouter, та же gpt-oss бесплатно (ключ openrouter.ai, ~50 запросов в день)
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=openai/gpt-oss-120b:free
#   OPENAI_API_KEY=<ключ OpenRouter>
# Внимание: GitHub Models закрыт 30.07.2026 — models.github.ai больше не работает.
# Картинки бесплатно и без ключа: Pollinations (≈1 запрос в 15 с; для демо достаточно)
#   IMAGE_PROVIDER=pollinations
#   POLLINATIONS_API_KEY=      # необязательно: бесплатный ключ с enter.pollinations.ai поднимает лимит
# Картинки бесплатно: Kandinsky (Сбер) — ключи в личном кабинете fusionbrain.ai, раздел API
#   IMAGE_PROVIDER=kandinsky
#   KANDINSKY_API_KEY=<API key>
#   KANDINSKY_SECRET_KEY=<Secret key>
# Картинки платно от OpenAI: gpt-image-1 через ProxyAPI (оплата в рублях) — бесплатного API у gpt-image-1 нет
#   IMAGE_PROVIDER=openai
#   IMAGE_BASE_URL=https://api.proxyapi.ru/openai/v1
#   IMAGE_API_KEY=<ключ ProxyAPI>
#   IMAGE_MODEL=gpt-image-1

# offline | openai | codex
LLM_PROVIDER=offline
OPENAI_API_KEY=              # для openai; для YandexGPT — его API-ключ
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# YandexGPT:  OPENAI_BASE_URL=https://llm.api.cloud.yandex.net/v1
#             OPENAI_MODEL=gpt://<folder_id>/yandexgpt-lite/latest
CODEX_BIN=codex
CODEX_MODEL=

IMAGE_PROVIDER=offline       # offline | pollinations | kandinsky | openai
IMAGE_MODEL=gpt-image-1
IMAGE_BASE_URL=              # пусто = как у текста
IMAGE_API_KEY=               # пусто = как у текста
IMAGE_SIZE=1536x1024
KANDINSKY_API_KEY=
KANDINSKY_SECRET_KEY=
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=flux

AI_MEDIA_BASE_URL=http://ai-agent:8000/media
HISTORY_LIMIT=12
KB_TOP_K=5

# DATABASE_URL уже есть в общем .env (postgresql+asyncpg://...@db:5432/cyber102) — агент использует его же
