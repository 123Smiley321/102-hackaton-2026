DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/marketer
TELEGRAM_BOT_TOKEN=
TELEGRAM_TARGET_CHAT=
ADMIN_API_KEY=replace-with-long-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
VK_API_VERSION=5.199
# AI-агент Ангелины; оставить пустым до подключения её сервиса
AI_AGENT_URL=
PUBLIC_BASE_URL=http://localhost:8000
# ВАЖНО: VK-токен тестового сообщества НЕ храним здесь.
# Он кладётся в БД через API (поле vk_access_token компании, шифруется Fernet ключом выше)
# и подхватывается модулем публикаций автоматически.
