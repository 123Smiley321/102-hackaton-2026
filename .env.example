# Общая БД
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/marketer

# Backend и Telegram-бот
TELEGRAM_BOT_TOKEN=
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=
# Отдельный ключ только для Backend ↔ publications; генерировать отдельно от ADMIN_API_KEY
PUBLISHER_INTERNAL_KEY=
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
PUBLIC_BASE_URL=http://localhost:8000

# Внутренний канал Backend/bot/publications ↔ AI-agent
AI_AGENT_URL=http://ai-agent:8000/v1/generate
# Отдельный случайный ключ; оставить пустым можно только для изолированного локального демо
AI_AGENT_API_KEY=

# AI-agent: без OPENAI_API_KEY используйте offline; для YandexGPT укажите openai
LLM_PROVIDER=offline
OPENAI_BASE_URL=https://llm.api.cloud.yandex.net/v1
OPENAI_MODEL=gpt://<folder_id>/yandexgpt/latest
OPENAI_API_KEY=
# Схема Api-Key и x-folder-id для Yandex Cloud подставляются автоматически
OPENAI_AUTH_SCHEME=
LLM_RETRY_WAIT=16

# Изображения: Pollinations без обязательного ключа; при сбое агент рисует offline-иллюстрацию
IMAGE_PROVIDER=pollinations
POLLINATIONS_TIMEOUT=25
POLLINATIONS_BASE_URL=https://image.pollinations.ai
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=flux
POLLINATIONS_RETRY_WAIT=16
# HTTPS-публичный адрес /media нужен только для offline/openai/kandinsky-картинок
AI_PUBLIC_MEDIA_BASE_URL=
HISTORY_LIMIT=12
KB_TOP_K=5

VK_API_VERSION=5.199

# Worker публикаций (через docker-compose получает только разрешённые переменные)
BACKEND_URL=http://backend:8000
SCHEDULER_INTERVAL_SEC=15
MONITOR_INTERVAL_SEC=60
PUBLICATION_BATCH_SIZE=50
BACKEND_TIMEOUT_SEC=100

# VK community token сюда НЕ копировать. Он сохраняется через POST/PATCH компании
# в поле vk_access_token, зашифровывается Fernet и остаётся только в БД/Backend.
# OPENAI_API_KEY передаётся только контейнеру ai-agent, не Backend/bot/publications.
