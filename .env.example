# Общая БД
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/marketer

# Backend и Telegram-бот
TELEGRAM_BOT_TOKEN=
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=
# Отдельный ключ только для Backend ↔ publications; генерировать отдельно от ADMIN_API_KEY
PUBLISHER_INTERNAL_KEY=
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
PUBLIC_BASE_URL=http://localhost:8000

# AI-агент Ангелины; оставить пустым до подключения сервиса
AI_AGENT_URL=
VK_API_VERSION=5.199

# Worker публикаций (через docker-compose получает только разрешённые переменные)
BACKEND_URL=http://backend:8000
SCHEDULER_INTERVAL_SEC=15
MONITOR_INTERVAL_SEC=60
PUBLICATION_BATCH_SIZE=50
BACKEND_TIMEOUT_SEC=100

# VK community token сюда НЕ копировать. Он сохраняется через POST/PATCH компании
# в поле vk_access_token, зашифровывается Fernet и остаётся только в БД/Backend.
