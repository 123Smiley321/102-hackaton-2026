TELEGRAM_BOT_TOKEN=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=
# Generate a different value for the Backend ↔ publication worker channel.
PUBLISHER_INTERNAL_KEY=
AI_AGENT_URL=
# Must match AI_AGENT_API_KEY on the AI-agent when internal authentication is enabled.
AI_AGENT_API_KEY=
VK_API_VERSION=5.199
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
PUBLIC_BASE_URL=http://localhost:8000

# VK/MAX tokens are accepted only through the company API and stored encrypted in DB.
# Do not add MAX_ACCESS_TOKEN here: use each company's max_access_token field via POST/PATCH.
